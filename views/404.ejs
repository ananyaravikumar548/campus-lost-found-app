<%- include('partials/header') %>

<div class="empty-state" style="padding: 5rem 2rem;">
  <div style="font-size: 4rem; margin-bottom: 1rem;">🔎</div>
  <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem; color: var(--text-main);">404 - Page Not Found</h1>
  <p class="empty-state-text" style="font-size: 1.05rem;">
    <%= typeof message !== 'undefined' ? message : "The page or record you are searching for does not exist on the campus system or may have been moved." %>
  </p>
  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
    <a href="/" class="btn btn-primary">Return Home</a>
    <a href="/lost-items" class="btn btn-secondary">Browse Lost Items</a>
    <a href="/found-items" class="btn btn-secondary">Browse Found Items</a>
  </div>
</div>

<%- include('partials/footer') %>
