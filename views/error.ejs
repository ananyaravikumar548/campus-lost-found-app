<%- include('partials/header') %>

<div class="empty-state" style="padding: 4.5rem 2rem; border-color: var(--danger-border); background: rgba(239, 68, 68, 0.04);">
  <div style="font-size: 3.5rem; margin-bottom: 1rem;">⚠️</div>
  <div style="margin-bottom: 0.75rem;">
    <span class="badge" style="background: var(--danger-bg); border: 1px solid var(--danger-border); color: #f87171; font-size: 0.95rem; padding: 0.4rem 0.9rem;">
      HTTP <%= statusCode || 500 %> Error
    </span>
  </div>
  <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.75rem; color: var(--text-main);">
    <%= title || 'Action Could Not Be Completed' %>
  </h1>
  <p class="empty-state-text" style="font-size: 1.05rem; color: #cbd5e1; max-width: 580px;">
    <%= message || 'An unexpected error occurred while processing your request.' %>
  </p>

  <% if (typeof details !== 'undefined' && details && details.length > 0) { %>
    <div style="max-width: 500px; margin: 1.5rem auto; text-align: left; background: rgba(0, 0, 0, 0.3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 1rem 1.25rem;">
      <div style="font-weight: 700; font-size: 0.85rem; color: #f87171; margin-bottom: 0.5rem; text-transform: uppercase;">Validation Details:</div>
      <ul style="margin-left: 1.25rem; font-size: 0.875rem; color: #e2e8f0; line-height: 1.6;">
        <% details.forEach(err => { %>
          <li><%= err %></li>
        <% }) %>
      </ul>
    </div>
  <% } %>

  <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin-top: 1rem;">
    <a href="javascript:history.back()" class="btn btn-secondary">&larr; Go Back</a>
    <a href="/" class="btn btn-primary">Return to Home</a>
  </div>
</div>

<%- include('partials/footer') %>
