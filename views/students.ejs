<%- include('partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Student Directory</h1>
    <p class="page-subtitle">Registered student profiles linked to lost and found reports across campus</p>
  </div>
  <a href="/students/new" class="btn btn-primary">
    <span>+</span> Register New Student
  </a>
</div>

<!-- Search Filter Bar -->
<form action="/students" method="GET" class="filter-bar">
  <div class="search-input-wrapper">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      type="text"
      name="search"
      class="form-control"
      placeholder="Search by student name, email, or department..."
      value="<%= search || '' %>"
    >
  </div>

  <button type="submit" class="btn btn-secondary">Search</button>
  <% if (search) { %>
    <a href="/students" class="btn btn-secondary btn-sm" style="color: var(--text-faint);">Reset</a>
  <% } %>
</form>

<% if (students.length === 0) { %>
  <div class="empty-state">
    <div class="empty-state-icon">👤</div>
    <h3 class="empty-state-title">No students found</h3>
    <p class="empty-state-text">
      <% if (search) { %>
        No student matches "<%= search %>". Check spelling or clear search filter.
      <% } else { %>
        No students have registered in the portal yet. Create the first student profile to begin reporting items!
      <% } %>
    </p>
    <a href="/students/new" class="btn btn-primary">Register Student Profile</a>
  </div>
<% } else { %>
  <div class="students-grid">
    <% students.forEach(student => { %>
      <div class="student-card">
        <div class="student-header">
          <div class="student-avatar">
            <%= student.fullName.charAt(0).toUpperCase() %>
          </div>
          <div>
            <a href="/students/<%= student._id %>" class="student-name">
              <%= student.fullName %>
            </a>
            <div class="student-dept"><%= student.department %></div>
          </div>
        </div>

        <div style="font-size: 0.85rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.35rem;">
          <div>✉️ <%= student.email %></div>
          <div>📞 <%= student.contactNumber %></div>
          <div style="margin-top: 0.35rem;">
            <span class="code-badge">ID: <%= student._id %></span>
          </div>
        </div>

        <div style="margin-top: auto; padding-top: 0.75rem; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-between; align-items: center;">
          <a href="/students/<%= student._id %>" class="btn btn-secondary btn-sm" style="width: 100%;">
            View Profile & Activity &rarr;
          </a>
        </div>
      </div>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
